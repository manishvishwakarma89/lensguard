DATABASE_URL=mysql+pymysql://lensguard:lensguard@localhost:3306/lensguard
COLLECT_INTERVAL=30
# KUBE_CONTEXT=kind-lensguard
IGNORED_NAMESPACES=kube-system,local-path-storage
CPU_ALERT_PCT=85
MEM_ALERT_PCT=85

# Optional notifications
NOTIFY_MIN_SEVERITY=warning
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Optional AI explanations (opt-in, off by default)
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
